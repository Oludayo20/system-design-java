# --- App ---
PORT=3011

# --- PostgreSQL ---
# One instance, single schema (books, members, loans).
# Host port 5433 (not 5432) to avoid clashing with other local Postgres containers; only
# matters when running the API on the host against `docker compose up -d postgres` (Option B
# in README.md) -- inside the compose network the api service always reaches postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=library
POSTGRES_PASSWORD=library_dev_password
POSTGRES_DB=library
