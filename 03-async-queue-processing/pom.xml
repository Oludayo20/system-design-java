<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.systemdesign</groupId>
  <artifactId>async-queue-processing</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>async-queue-processing</name>
  <description>
    Java/Spring Boot port of the async-queue-processing reference project: a producer (API) that
    saves a ride and publishes ride.completed to RabbitMQ without waiting on it, independent
    email/analytics/loyalty workers with TTL+DLX retry and a dead letter queue, and a standalone
    Kafka broadcast-comparison producer/consumer.
  </description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.6.0</springdoc.version>
  </properties>

  <dependencies>
    <!-- Producer (API) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- RabbitMQ (API publisher + worker consumers) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>

    <!-- Kafka broadcast-comparison (standalone scripts, see src/.../kafka) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Swagger / OpenAPI docs at /docs, mirrors the NestJS SwaggerModule setup -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            Default entrypoint is the API (producer). The worker (consumer) process is the SAME
            jar, launched with the LOADER_MAIN env var (or -Dloader.main=...) pointed at
            WorkerApplication instead — see docker-compose.yml's `worker` service and the
            Dockerfile. This mirrors the original's single `dist/` output with two independently
            runnable entrypoints (dist/main.js vs dist/worker.main.js).
          -->
          <mainClass>com.systemdesign.asyncqueue.api.ApiApplication</mainClass>
          <layout>PropertiesLauncher</layout>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Lets the standalone Kafka scripts (com.systemdesign.asyncqueue.kafka.*App) run without a
        full Spring Boot context, mirroring how the original ran them with plain `ts-node`
        instead of `nest start`. Not bound to any lifecycle phase — invoked explicitly, e.g.:
          mvn compile exec:java -Dexec.mainClass=com.systemdesign.asyncqueue.kafka.OrderEventsProducerApp
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
    </plugins>
  </build>
</project>
