# HTTP port for the Spring Boot app
PORT=3000

# How many shards exist and which strategy routes keys to them.
# hash  - default. hash(userId) % SHARD_COUNT. Even distribution.
# range - bucket by numeric id ranges (see ShardingStrategyFactory).
# geo   - route by region (africa/europe/asia -> shard 0/1/2).
#
# Note: the physical shard topology (3 DataSource/JdbcTemplate beans, see
# config/DataSourceConfig.java) is fixed at 3 shards. SHARD_COUNT only feeds
# the active strategy's shard-count math (e.g. the hash modulo divisor, or
# how many range boundaries get generated) - matching this project's
# always-3-shards docker-compose topology.
SHARD_COUNT=3
SHARDING_STRATEGY=hash

# One block per shard, following the SHARD_<index>_* pattern read directly
# from the environment by config/DataSourceConfig.java. Defaults below match
# docker-compose.yml when running the API outside Docker against the
# compose Postgres containers (which publish shard-0/1/2 on host ports
# 5432/5433/5434).
SHARD_0_HOST=localhost
SHARD_0_PORT=5432
SHARD_0_DB=shard_0
SHARD_0_USER=postgres
SHARD_0_PASSWORD=postgres

SHARD_1_HOST=localhost
SHARD_1_PORT=5433
SHARD_1_DB=shard_1
SHARD_1_USER=postgres
SHARD_1_PASSWORD=postgres

SHARD_2_HOST=localhost
SHARD_2_PORT=5434
SHARD_2_DB=shard_2
SHARD_2_USER=postgres
SHARD_2_PASSWORD=postgres

# Used by IdGeneratorService to keep IDs unique if you ever run more than
# one API process (each process should get a distinct WORKER_ID).
WORKER_ID=1
