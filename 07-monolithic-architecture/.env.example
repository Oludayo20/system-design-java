# --- App ---
PORT=3007

# --- PostgreSQL ---
# One instance, one shared database, no schema-per-module split — every module's table
# (users, posts, comments, notifications) lives in the same `public` schema.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=blogstack
POSTGRES_PASSWORD=blogstack_dev_password
POSTGRES_DB=blogstack

# --- Auth / JWT ---
JWT_SECRET=change_me_in_production_please
JWT_EXPIRES_IN=1h
