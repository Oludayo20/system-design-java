# --- App ---
PORT=3012

# --- Adapter selection ---
# This is the whole point of the project: flip these and restart, nothing in
# src/main/java/com/systemdesign/orbit/core changes.
# APP_REPOSITORY: memory | postgres
APP_REPOSITORY=memory
# APP_PAYMENT_PROVIDER: stripe | flutterwave
APP_PAYMENT_PROVIDER=stripe

# --- PostgreSQL (only read when APP_REPOSITORY=postgres) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_dev_password
POSTGRES_DB=orbit
